    def preview_theme(self) -> None:
        previous = self.theme.name
        self.theme = Theme(self.theme_var.get())
        self.theme.apply(self.root, self.style)

        if not messagebox.askyesno("Theme Preview", f"Keep theme '{self.theme.name}'?"):
            self.theme = Theme(previous)
            self.theme_var.set(previous)
            self.theme.apply(self.root, self.style)

        self.update_theme_description()

    def apply_and_save_preferences(self) -> None:
        """Apply and save all user preferences, including profile config location."""
        self.xfreerdp_path = Path(self.xfreerdp_path_var.get()).expanduser()
        self.smartcard_manager = SmartcardManager(self.xfreerdp_path)

        self.config_file = Path(self.config_file_var.get()).expanduser()
        if not self.config_file.name:
            messagebox.showerror("Error", "Profile Config File must be a file path, not a directory.")
            return

        self.theme = Theme(self.theme_var.get())
        self.theme.apply(self.root, self.style)

        self.profiles["preferences"] = {
            "config_file": str(self.config_file),
            "xfreerdp_path": str(self.xfreerdp_path),
            "theme": self.theme.name,
            "log_dir": self.log_dir_var.get(),
            "log_level": self.log_level_var.get(),
        }

        self.save_profiles()
        self.configure_logging()
        self.status(f"Preferences saved to {self.config_file}")
        messagebox.showinfo("Success", f"Preferences saved to:\n{self.config_file}")

    def reset_preferences(self) -> None:
