class XFreeRDPWrapper:
    """ZRDP application controller."""

    def __init__(self, root: tk.Tk) -> None:
        self.root = root
        self.root.title(f"{APP_NAME} - XFreeRDP Wrapper v{APP_VERSION}")

        self.executor = ThreadPoolExecutor(max_workers=4, thread_name_prefix="zrdp")
        self.connection_lock = Lock()
        self.connections: list[ConnectionInfo] = []
        self.smartcards: list[Smartcard] = []
        self.config_file = CONFIG_FILE.expanduser()

        self.profiles = self.load_profiles()
        preferences = self.profiles.setdefault("preferences", {})

        self.xfreerdp_path = Path(
            preferences.get("xfreerdp_path")
            or shutil.which("xfreerdp")
            or "/usr/local/bin/xfreerdp"
        ).expanduser()

        self.theme = Theme(preferences.get("theme", "Dark Professional"))
        self.style = ttk.Style()
        self.theme.apply(self.root, self.style)

        self.configure_logging()
        self.smartcard_manager = SmartcardManager(self.xfreerdp_path)

        self.create_widgets()
        self.load_profile_list()
        self.refresh_smartcards()
        self.scale_to_content()

        self.root.protocol("WM_DELETE_WINDOW", self.close)

    # -----------------------------
    # Generic UI and worker helpers
    # -----------------------------

    def ui(self, func: Callable[[], None]) -> None:
        """Schedule work on Tk's main thread."""
        self.root.after(0, func)

    @staticmethod
    def now() -> str:
        return time.strftime("%H:%M:%S")

    def status(self, message: str) -> None:
        self.status_var.set(f"[{self.now()}] {message}")
        logging.info(message)

    def submit(self, func: Callable[[], Any], done: Callable[[Future[Any]], None]) -> None:
        future = self.executor.submit(func)
        future.add_done_callback(lambda f: self.ui(lambda: done(f)))

    def scale_to_content(self) -> None:
        """Scale initial window vertically to fit collapsed text without exceeding screen."""
        self.root.update_idletasks()

        screen_w = self.root.winfo_screenwidth()
        screen_h = self.root.winfo_screenheight()
        width = min(max(self.root.winfo_reqwidth() + 24, 950), screen_w - 80)
        height = min(max(self.root.winfo_reqheight() + 24, 520), screen_h - 80)

        self.root.geometry(f"{width}x{height}")
        self.root.minsize(900, min(height, 650))

    # -----------------------------
    # Configuration and logging
    # -----------------------------

    def configure_logging(self) -> None:
        prefs = self.profiles.get("preferences", {})
        log_file = Path(prefs.get("log_dir", "~/zrdp.log")).expanduser()
        log_file.parent.mkdir(parents=True, exist_ok=True)

        level_name = str(prefs.get("log_level", "INFO")).upper()
        level = {"OFF": logging.CRITICAL + 1, "TRACE": logging.DEBUG, "WARN": logging.WARNING}.get(
            level_name,
            getattr(logging, level_name, logging.INFO),
        )

        logging.basicConfig(
            filename=log_file,
            level=level,
            format="%(asctime)s %(levelname)s %(message)s",
            force=True,
        )

    def load_profiles(self) -> dict[str, Any]:
        """Load profiles from the configured JSON file.

        Bootstrap rules:
        1. The default profile/config file is ~/.zrdp.json.
        2. If ~/.zrdp.json does not exist but the legacy
           ~/.xfreerdp_profiles.json file exists, import that data.
        3. If the loaded data contains preferences.config_file, use that path.
        """
        self.config_file = CONFIG_FILE.expanduser()
        bootstrap_file = self.config_file

        # Import legacy profiles if the new default file has not been created yet.
        if not bootstrap_file.exists() and LEGACY_CONFIG_FILE.exists():
            bootstrap_file = LEGACY_CONFIG_FILE

        try:
            profiles = (
                json.loads(bootstrap_file.read_text(encoding="utf-8"))
                if bootstrap_file.exists()
                else {}
            )
        except (OSError, json.JSONDecodeError) as exc:
            logging.error("Failed to load profiles from %s: %s", bootstrap_file, exc)
            profiles = {}

        preferences = profiles.setdefault("preferences", {})
        configured_file = preferences.get("config_file")

        if configured_file:
            candidate = Path(configured_file).expanduser()

            # If a custom config path is configured and exists, load from it.
            # If it does not exist yet, keep the current profile data in memory
            # and save it to that path when preferences are applied.
            self.config_file = candidate

            if candidate.exists() and candidate != bootstrap_file:
                try:
                    profiles = json.loads(candidate.read_text(encoding="utf-8"))
                    profiles.setdefault("preferences", {})["config_file"] = str(candidate)
                except (OSError, json.JSONDecodeError) as exc:
                    logging.error("Failed to load configured profile file %s: %s", candidate, exc)
        else:
            # Store the new default path in preferences so it is visible/editable.
            preferences["config_file"] = str(self.config_file)

        return profiles

    def save_profiles(self) -> None:
        """Save profiles to the configured JSON file."""
        try:
            self.config_file = Path(self.config_file).expanduser()
            self.config_file.parent.mkdir(parents=True, exist_ok=True)
            self.profiles.setdefault("preferences", {})["config_file"] = str(self.config_file)
            self.config_file.write_text(json.dumps(self.profiles, indent=2), encoding="utf-8")
        except OSError as exc:
            messagebox.showerror("Error", f"Failed to save profiles: {exc}")
            logging.error("Failed to save profiles to %s: %s", self.config_file, exc)

    # -----------------------------
    # Widget creation
    # -----------------------------

    def create_widgets(self) -> None:
        self.header = ttk.Label(
            self.root,
            text=f"{APP_NAME} - XFreeRDP Wrapper v{APP_VERSION}",
            font=self.theme.font("heading"),
        )
        self.header.pack(fill=tk.X, padx=10, pady=(10, 0))

        self.notebook = ttk.Notebook(self.root)
        self.notebook.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)

        self.create_connection_tab()
        self.create_preferences_tab()

        self.status_var = tk.StringVar(value="Ready")
        ttk.Label(self.root, textvariable=self.status_var).pack(fill=tk.X, padx=10, pady=(0, 6))

    def create_connection_tab(self) -> None:
        tab = ttk.Frame(self.notebook, padding=10)
        self.notebook.add(tab, text="Connection")

        self.create_profile_section(tab)
        self.create_connection_settings(tab)
        self.create_control_buttons(tab)

    def create_profile_section(self, parent: ttk.Frame) -> None:
        frame = ttk.LabelFrame(parent, text="Profile Management", padding=10)
        frame.pack(fill=tk.X, pady=(0, 10))

        self.profile_listbox = tk.Listbox(
            frame,
            height=5,
            width=34,
            bg=self.theme.color("panel"),
            fg=self.theme.color("text"),
            selectbackground=self.theme.color("highlight"),
            relief=tk.FLAT,
        )
        self.profile_listbox.grid(row=0, column=0, rowspan=5, sticky=tk.NSEW, padx=(0, 10))
        self.profile_listbox.bind("<<ListboxSelect>>", self.on_profile_selected)

        buttons = (
            ("Connect", self.connect),
            ("Load", self.load_selected_profile),
            ("Save", self.save_current_profile),
            ("Delete", self.delete_profile),
            ("New", self.new_profile),
        )
        for row, (text, command) in enumerate(buttons):
            ttk.Button(frame, text=text, command=command).grid(row=row, column=1, sticky=tk.EW, pady=2)

        frame.columnconfigure(0, weight=1)

    def create_connection_settings(self, parent: ttk.Frame) -> None:
        frame = ttk.LabelFrame(parent, text="Connection Settings", padding=10)
        frame.pack(fill=tk.BOTH, expand=True, pady=(0, 10))

        self.server_var = tk.StringVar()
        self.port_var = tk.StringVar(value="3389")
        self.username_var = tk.StringVar()
        self.domain_var = tk.StringVar(value="moesol.local")

        self.entry_row(frame, 0, "Server:", self.server_var, "Port:", self.port_var, port=True)
        self.entry_row(frame, 1, "Username:", self.username_var, "Domain:", self.domain_var)

        self.create_security_section(frame, row=2)
        self.create_kerberos_section(frame, row=3)
        self.create_smartcard_section(frame, row=4)
        self.create_display_section(frame, row=5)
        self.create_notes_section(frame, row=6)

        frame.columnconfigure(1, weight=1)

    @staticmethod
    def entry(parent: tk.Widget, var: tk.StringVar, *, width: int = 28) -> ttk.Entry:
        return ttk.Entry(parent, textvariable=var, width=width)

    def entry_row(
        self,
        parent: ttk.Frame,
        row: int,
        label1: str,
        var1: tk.StringVar,
        label2: str,
        var2: tk.StringVar,
        *,
        port: bool = False,
    ) -> None:
        ttk.Label(parent, text=label1).grid(row=row, column=0, sticky=tk.W, pady=4)
        self.entry(parent, var1, width=42).grid(row=row, column=1, sticky=tk.EW, padx=(6, 16), pady=4)
        ttk.Label(parent, text=label2).grid(row=row, column=2, sticky=tk.W, pady=4)
        self.entry(parent, var2, width=8 if port else 18).grid(row=row, column=3, sticky=tk.W, padx=(6, 0), pady=4)

    def create_security_section(self, parent: ttk.Frame, *, row: int) -> None:
        """Create collapsible security settings without grid-cell overlap."""
        section = CollapsibleSection(parent, "Security Settings", open_=False)
        section.grid(row=row, column=0, columnspan=4, sticky=tk.EW, pady=(8, 0))

        # Security option state variables.
        self.sec_nla_var = tk.BooleanVar(value=True)
        self.sec_tls_var = tk.BooleanVar(value=True)
        self.sec_ext_var = tk.BooleanVar(value=True)
        self.cert_ignore_var = tk.BooleanVar(value=True)
        self.fips_var = tk.BooleanVar(value=False)
        self.session_timeout_var = tk.StringVar(value="30")

        # Place security controls explicitly to avoid future grid collisions.
        ttk.Checkbutton(
            section.body,
            text="NLA",
            variable=self.sec_nla_var,
        ).grid(row=0, column=0, sticky=tk.W, padx=(0, 24), pady=2)

        ttk.Checkbutton(
            section.body,
            text="TLS",
            variable=self.sec_tls_var,
        ).grid(row=0, column=1, sticky=tk.W, padx=(0, 24), pady=2)

        ttk.Checkbutton(
            section.body,
            text="EXT",
            variable=self.sec_ext_var,
        ).grid(row=1, column=0, sticky=tk.W, padx=(0, 24), pady=2)

        ttk.Checkbutton(
            section.body,
            text="Ignore Certificate",
            variable=self.cert_ignore_var,
        ).grid(row=1, column=1, sticky=tk.W, padx=(0, 24), pady=2)

        # FIPS Mode is intentionally retained in Security Settings.
        ttk.Checkbutton(
            section.body,
            text="FIPS Mode",
            variable=self.fips_var,
        ).grid(row=2, column=0, sticky=tk.W, padx=(0, 24), pady=2)

        # Session Timeout is on its own row so it cannot hide FIPS Mode.
        ttk.Label(
            section.body,
            text="Session Timeout (min):",
        ).grid(row=3, column=0, sticky=tk.W, pady=(8, 4))

        ttk.Entry(
            section.body,
            textvariable=self.session_timeout_var,
            width=10,
        ).grid(row=3, column=1, sticky=tk.W, pady=(8, 4))

        # Keep layout predictable.
        section.body.columnconfigure(0, weight=0)
        section.body.columnconfigure(1, weight=0)

