    def set_settings(self, settings: dict[str, Any]) -> None:
        defaults = {
            "server": "",
            "port": "3389",
            "username": "",
            "domain": "moesol.local",
            "sec_nla": True,
            "sec_tls": True,
            "sec_ext": True,
            "cert_ignore": True,
            "fips": False,
            "session_timeout": "30",
            "kerberos_enabled": False,
            "kerberos_principal": "",
            "smartcard": "None",
            "size": "1920x1080",
            "fullscreen": False,
            "bpp": "32",
        }
        data = defaults | settings

        for key, var in {
            "server": self.server_var,
            "port": self.port_var,
            "username": self.username_var,
            "domain": self.domain_var,
            "session_timeout": self.session_timeout_var,
            "kerberos_principal": self.kerberos_principal_var,
            "size": self.size_var,
            "bpp": self.bpp_var,
        }.items():
            var.set(data[key])

        for key, var in {
            "sec_nla": self.sec_nla_var,
            "sec_tls": self.sec_tls_var,
            "sec_ext": self.sec_ext_var,
            "cert_ignore": self.cert_ignore_var,
            "fips": self.fips_var,
            "kerberos_enabled": self.kerberos_enabled_var,
            "fullscreen": self.fullscreen_var,
        }.items():
            var.set(bool(data[key]))

        smartcard = data["smartcard"]
        self.smartcard_var.set(smartcard if smartcard in self.smartcard_combo["values"] else "None")

    # -----------------------------
    # Kerberos
    # -----------------------------

    def principal(self) -> str:
        """Use explicit principal, or infer username@DOMAIN when possible."""
        explicit = self.kerberos_principal_var.get().strip()
        if explicit:
            return explicit

        user = self.username_var.get().strip()
        domain = self.domain_var.get().strip()
        return f"{user}@{domain.upper()}" if user and domain else user

    def set_kerberos_text(self, text: str) -> None:
        self.kerberos_text.configure(state=tk.NORMAL)
        self.kerberos_text.delete("1.0", tk.END)
        self.kerberos_text.insert("1.0", text)
        self.kerberos_text.configure(state=tk.DISABLED)

    def on_kerberos_toggle(self) -> None:
        if self.kerberos_enabled_var.get():
            self.refresh_kerberos(auto_kinit=True)
        else:
            self.set_kerberos_text("Kerberos disabled.")
            self.status("Kerberos disabled")

    def refresh_kerberos(self, *, auto_kinit: bool, callback: Callable[[bool], None] | None = None) -> None:
        if not self.kerberos_enabled_var.get():
            callback(False) if callback else None
            return

        self.status("Checking Kerberos tickets with klist")

        def done(future: Future[tuple[list[str], str]]) -> None:
            try:
                tickets, raw = future.result()
            except Exception as exc:
                self.set_kerberos_text(f"klist failed: {exc}")
                callback(False) if callback else None
                return

            if tickets:
                self.set_kerberos_text("KRBTGT ticket(s):\n" + "\n".join(tickets))
                self.status(f"Found {len(tickets)} KRBTGT ticket(s)")
                callback(True) if callback else None
                return

            self.set_kerberos_text(f"No KRBTGT ticket found.\n\nklist output:\n{raw or '(empty)'}")
            self.status("No KRBTGT ticket found")

            if auto_kinit:
                self.run_kinit(callback=callback)
            elif callback:
                callback(False)

        self.submit(KerberosManager.tickets, done)

    def run_kinit(self, callback: Callable[[bool], None] | None) -> None:
        principal = self.principal()
        password = simpledialog.askstring("Kerberos Login", "Enter Password:", show="*", parent=self.root)
        if not password:
            callback(False) if callback else None
            return

        self.status(f"Running kinit for {principal or 'default principal'}")

        def worker() -> tuple[bool, str]:
            return KerberosManager.kinit(principal, password)

        def done(future: Future[tuple[bool, str]]) -> None:
            try:
                ok, output = future.result()
            except Exception as exc:
                self.set_kerberos_text(f"kinit failed: {exc}")
                callback(False) if callback else None
                return

            if ok:
                self.status("Kerberos initialization succeeded")
                self.refresh_kerberos(auto_kinit=False, callback=callback)
            else:
                self.set_kerberos_text(f"kinit failed:\n{output or '(no output)'}")
                self.status("Kerberos initialization failed")
                callback(False) if callback else None

        self.submit(worker, done)

    # -----------------------------
    # Smartcards
    # -----------------------------

    def refresh_smartcards(self) -> None:
        self.status("Scanning for smartcards")

        def done(future: Future[list[Smartcard]]) -> None:
            try:
                self.smartcards = future.result()
                values = ["None", *(card.label for card in self.smartcards)]
                self.smartcard_combo.configure(values=values)
                if self.smartcard_var.get() not in values:
                    self.smartcard_var.set("None")
                self.status(f"Found {len(self.smartcards)} smartcard(s)")
            except Exception as exc:
                self.status(f"Smartcard scan failed: {exc}")

        self.submit(self.smartcard_manager.detect, done)

    def selected_reader(self) -> str:
        selected = self.smartcard_var.get()
        return next((card.reader_name for card in self.smartcards if card.label == selected), "")

    # -----------------------------
    # Command construction
    # -----------------------------

    def build_command(self) -> list[str]:
        cmd = [str(self.xfreerdp_path)]

        if server := self.server_var.get().strip():
            cmd.append(f"/v:{server}")
        if (port := self.port_var.get().strip()) and port != "3389":
            cmd.append(f"/port:{port}")
        if username := self.username_var.get().strip():
            cmd.append(f"/u:{username}")
        if domain := self.domain_var.get().strip():
            cmd.append(f"/d:{domain}")

        cmd.extend(
            flag
            for enabled, flag in (
                (self.sec_nla_var.get(), "/sec:nla"),
                (self.sec_tls_var.get(), "/sec:tls"),
                (self.sec_ext_var.get(), "/sec:ext"),
                (self.cert_ignore_var.get(), "/cert:ignore"),
                (self.fips_var.get(), "+fipsmode"),
            )
            if enabled
        )

        if reader := self.selected_reader():
            cmd.append(f"/smartcard:{reader}")

        cmd.append("+f" if self.fullscreen_var.get() else f"/size:{self.size_var.get().strip() or '1920x1080'}")

        if bpp := self.bpp_var.get().strip():
            cmd.append(f"/bpp:{bpp}")

        if timeout := self.session_timeout_var.get().strip():
            try:
                cmd.append(f"/timeout:{int(timeout) * 60}")
            except ValueError:
                messagebox.showwarning("Warning", "Invalid session timeout value")

        log_level = self.profiles.get("preferences", {}).get("log_level", "INFO")
        if log_level != "OFF":
            cmd.append(f"/log-level:{log_level}")

        return cmd

    def show_command(self) -> None:
        command = " ".join(self.build_command())
        window = tk.Toplevel(self.root)
        window.title("Generated Command")
        window.geometry("820x240")
        window.configure(bg=self.theme.color("bg"))

        text = tk.Text(
            window,
            wrap=tk.WORD,
            bg=self.theme.color("panel"),
            fg=self.theme.color("text"),
            font=self.theme.font("mono"),
            padx=10,
            pady=10,
        )
        text.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)
        text.insert("1.0", command)
        text.configure(state=tk.DISABLED)

        def copy() -> None:
            window.clipboard_clear()
            window.clipboard_append(command)
            messagebox.showinfo("Copied", "Command copied to clipboard")

        ttk.Button(window, text="Copy to Clipboard", command=copy).pack(pady=(0, 10))

    # -----------------------------
    # Connection operations
    # -----------------------------

    def validate_connection_fields(self) -> bool:
        if not self.server_var.get().strip():
            messagebox.showerror("Error", "Server address is required")
            return False
        if not self.username_var.get().strip():
            messagebox.showerror("Error", "Username is required")
            return False
        return True

    def connect(self) -> None:
        if not self.validate_connection_fields():
            return

        if self.kerberos_enabled_var.get():
            self.refresh_kerberos(auto_kinit=True, callback=lambda ok: self.start_connection(use_rdp_password=not ok))
        else:
            self.start_connection(use_rdp_password=True)

    def start_connection(self, *, use_rdp_password: bool) -> None:
        cmd = self.build_command()
        server = self.server_var.get().strip()

        if use_rdp_password:
            password = simpledialog.askstring("Password", "Enter Password:", show="*", parent=self.root)
            if not password:
                messagebox.showerror("Error", "Password is required")
                return
            cmd.append(f"/p:{password}")

        self.status(f"Connecting to {server}")

        def worker() -> None:
            process = subprocess.Popen(cmd)
            info = ConnectionInfo(process=process, server=server, started=self.now())

            with self.connection_lock:
                self.connections.append(info)

            self.ui(lambda: (self.status(f"Connected to {server}"), self.update_disconnect_button()))

            process.wait()

            with self.connection_lock:
                self.connections = [conn for conn in self.connections if conn.process != process]

            self.ui(lambda: (self.status(f"Connection to {server} closed"), self.update_disconnect_button()))

        def done(future: Future[None]) -> None:
            if exc := future.exception():
                messagebox.showerror("Connection Error", f"Failed to start connection to {server}: {exc}")
                self.status(f"Connection to {server} failed: {exc}")
                self.update_disconnect_button()

        self.submit(worker, done)

    def test_connection(self) -> None:
        server = self.server_var.get().strip()
        if not server:
            messagebox.showerror("Error", "Server address is required")
            return

        self.status("Testing connection")

        def worker() -> subprocess.CompletedProcess[str]:
            return subprocess.run(["ping", "-c", "1", "-W", "3", server], capture_output=True, text=True, timeout=10)

        def done(future: Future[subprocess.CompletedProcess[str]]) -> None:
            try:
                reachable = future.result().returncode == 0
                self.status(f"Server {server} is {'reachable' if reachable else 'not reachable'}")
                if reachable:
                    messagebox.showinfo("Test Result", f"{server} is reachable")
                else:
                    messagebox.showwarning("Test Result", f"{server} is not reachable")
            except Exception as exc:
                messagebox.showerror("Test Error", f"Connection test failed: {exc}")
                self.status(f"Connection test failed: {exc}")

        self.submit(worker, done)

    def update_disconnect_button(self) -> None:
        with self.connection_lock:
            active = len(self.connections)

        self.disconnect_btn.configure(
            text=f"Disconnect All ({active})" if active else "Disconnect All",
            state=tk.NORMAL if active else tk.DISABLED,
        )

    def disconnect_all(self) -> None:
        with self.connection_lock:
            connections = list(self.connections)
            self.connections.clear()

        if not connections:
            messagebox.showinfo("Info", "No active connections to disconnect")
            return

        disconnected = 0
        for conn in connections:
            try:
                conn.process.terminate()
                disconnected += 1
            except OSError as exc:
                logging.error("Failed to terminate %s: %s", conn.server, exc)

        self.status(f"Disconnected {disconnected} connection(s)")
        self.update_disconnect_button()

    def show_connections(self) -> None:
        with self.connection_lock:
            connections = list(self.connections)

        if not connections:
            messagebox.showinfo("Active Connections", "No active connections")
            return

        window = tk.Toplevel(self.root)
        window.title("Active RDP Connections")
        window.geometry("620x320")
        window.configure(bg=self.theme.color("bg"))

        tree = ttk.Treeview(window, columns=("Server", "Started", "Status"), show="headings", height=10)
        for column, width in (("Server", 260), ("Started", 120), ("Status", 120)):
            tree.heading(column, text=column)
            tree.column(column, width=width)

        def refresh() -> None:
            tree.delete(*tree.get_children())
            with self.connection_lock:
                current = list(self.connections)
            for conn in current:
                tree.insert("", tk.END, values=(conn.server, conn.started, "Running" if conn.process.poll() is None else "Closed"))

        def disconnect_selected() -> None:
            selected = tree.selection()
            if not selected:
                messagebox.showwarning("Warning", "Select a connection to disconnect")
                return

            server = str(tree.item(selected[0])["values"][0])
            with self.connection_lock:
                match = next((conn for conn in self.connections if conn.server == server), None)
                if match:
                    self.connections.remove(match)

            if match:
                match.process.terminate()
                self.status(f"Disconnected from {server}")
                self.update_disconnect_button()
                refresh()

        tree.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)
        refresh()

        buttons = ttk.Frame(window)
        buttons.pack(fill=tk.X, padx=10, pady=(0, 10))
        ttk.Button(buttons, text="Disconnect Selected", command=disconnect_selected).pack(side=tk.LEFT, padx=(0, 8))
        ttk.Button(buttons, text="Refresh", command=refresh).pack(side=tk.LEFT, padx=(0, 8))
        ttk.Button(buttons, text="Close", command=window.destroy).pack(side=tk.RIGHT)

    # -----------------------------
    # Shutdown
    # -----------------------------

    def close(self) -> None:
        self.disconnect_all() if self.connections else None
        self.executor.shutdown(wait=False, cancel_futures=True)
        self.root.destroy()


def main() -> None:
    root = tk.Tk()

    icon = Path(__file__).with_name("zrdp_icon.png")
    if icon.exists():
        try:
            image = tk.PhotoImage(file=icon)
            root.iconphoto(True, image)
            root._zrdp_icon = image
        except tk.TclError:
            logging.warning("Unable to load icon: %s", icon)

    XFreeRDPWrapper(root)
    root.mainloop()


if __name__ == "__main__":
    main()
