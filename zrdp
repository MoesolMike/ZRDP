# ---------------------------------------------------------------------------
# Prerequisite checks run before tkinter is imported so missing GUI packages
# fail fast with helpful terminal output.
# ---------------------------------------------------------------------------

APP_NAME: Final = "ZRDP"
APP_VERSION: Final = "1.2.1"
CONFIG_FILE: Final = Path.home() / ".zrdp.json"
LEGACY_CONFIG_FILE: Final = Path.home() / ".xfreerdp_profiles.json"

REQUIRED_MODULES: Final = {"tkinter": "python3-tk"}
REQUIRED_BINARIES: Final = {
    "xfreerdp": "freerdp2-x11 or freerdp3-x11",
    "kinit": "krb5-user",
    "klist": "krb5-user",
}
REQUIRED_DEBIAN_PACKAGES: Final = ("krb5-user", "krb5-config")


def _dpkg_installed(package: str) -> bool | None:
    """Return package status on Debian-family systems, or None when unavailable."""
    dpkg = shutil.which("dpkg-query")
    if not dpkg:
        return None

    try:
        result = subprocess.run(
            [dpkg, "-W", "-f=${Status}", package],
            capture_output=True,
            text=True,
            timeout=3,
            check=False,
        )
        return result.stdout.strip() == "install ok installed"
    except subprocess.SubprocessError:
        return False


def check_prerequisites() -> None:
    """Fail fast when required modules, binaries, or Debian packages are missing."""
    missing: list[str] = []

    missing.extend(
        f"Python module '{module}' — install with: sudo apt install {package}"
        for module, package in REQUIRED_MODULES.items()
        if importlib.util.find_spec(module) is None
    )

    for binary, package in REQUIRED_BINARIES.items():
        if binary == "xfreerdp":
            found = shutil.which(binary) or Path("/usr/local/bin/xfreerdp").exists()
        else:
            found = shutil.which(binary)
        if not found:
            missing.append(f"'{binary}' not found in PATH — install package: {package}")

    for package in REQUIRED_DEBIAN_PACKAGES:
        installed = _dpkg_installed(package)
        if installed is False:
            missing.append(f"Debian package '{package}' is not installed")

    if missing:
        print("ERROR: Missing prerequisites:\n", file=sys.stderr)
        print("\n".join(f"  - {item}" for item in missing), file=sys.stderr)
        print("\nInstall missing packages and try again.", file=sys.stderr)
        raise SystemExit(1)


check_prerequisites()

