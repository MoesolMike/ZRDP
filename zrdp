class SmartcardManager:
    """Detect and parse smartcards through xfreerdp."""

    CARD_START = re.compile(r"^\d+:\s*(?P<dn>.+)$")
    CN = re.compile(r"CN\s*=\s*([^,]+)")

    def __init__(self, xfreerdp_path: Path) -> None:
        self.xfreerdp_path = xfreerdp_path

    def detect(self) -> list[Smartcard]:
        result = subprocess.run(
            [str(self.xfreerdp_path), "/list:smartcard"],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
        return self.parse(result.stdout) if result.returncode == 0 else []

    @classmethod
    def parse(cls, output: str) -> list[Smartcard]:
        """Use pattern matching to keep xfreerdp smartcard parsing compact."""
        cards: list[Smartcard] = []
        current: Smartcard | None = None

        for raw in map(str.strip, output.splitlines()):
            if not raw or "smartcard reader detected" in raw:
                continue

            if match := cls.CARD_START.match(raw):
                if current:
                    cards.append(current)
                dn = match["dn"]
                current = Smartcard(
                    dn=dn,
                    cn=(cn.group(1).strip() if (cn := cls.CN.search(dn)) else "Unknown"),
                )
                continue

            if not current or not raw.startswith("*"):
                continue

            key, _, value = raw[1:].partition(":")
            value = value.strip()

            match key.strip():
                case "reader":
                    current.reader = value
                    current.reader_name = value.split(maxsplit=1)[0] if value else ""
                case "CSP":
                    current.csp = value
                case "slotId":
                    current.slot_id = value
                case "pkinitArgs":
                    current.pkinit_args = value
                case "containerName":
                    current.container_name = value
                case "UPN":
                    current.upn = value

        if current:
            cards.append(current)
        return cards


class KerberosManager:
    """Handle klist/kinit operations without shell=True."""

    TGT = re.compile(r"\bkrbtgt/[^@\s]+@[^\s]+", re.IGNORECASE)

    @staticmethod
    def tickets() -> tuple[list[str], str]:
        result = subprocess.run(
            ["klist"],
            capture_output=True,
            text=True,
            timeout=8,
            check=False,
        )
        output = "\n".join(part for part in (result.stdout, result.stderr) if part)
        return sorted(set(KerberosManager.TGT.findall(output))), output.strip()

    @staticmethod
    def kinit(principal: str, password: str) -> tuple[bool, str]:
        args = ["kinit", principal] if principal else ["kinit"]
        result = subprocess.run(
            args,
            input=f"{password}\n",
            capture_output=True,
            text=True,
            timeout=30,
            check=False,
        )
        output = "\n".join(part for part in (result.stdout, result.stderr) if part).strip()
        return result.returncode == 0, output


