    def test_xfreerdp_path(self) -> None:
        path = Path(self.xfreerdp_path_var.get()).expanduser()

        if not path.exists():
            messagebox.showerror("Error", f"Path does not exist: {path}")
            return

        if not path.is_file() or not (path.stat().st_mode & (stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)):
            messagebox.showerror("Error", f"File is not executable: {path}")
            return

        def worker() -> subprocess.CompletedProcess[str]:
            return subprocess.run([str(path), "--version"], capture_output=True, text=True, timeout=5, check=False)

        def done(future: Future[subprocess.CompletedProcess[str]]) -> None:
            try:
                result = future.result()
                if result.returncode == 0:
                    messagebox.showinfo("Success", f"XFreeRDP found:\n\n{result.stdout.strip()}")
                else:
                    messagebox.showwarning("Warning", f"xfreerdp returned code {result.returncode}")
            except Exception as exc:
                messagebox.showerror("Error", f"Failed to test path: {exc}")

        self.submit(worker, done)

