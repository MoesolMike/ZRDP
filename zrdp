class Theme:
    """Apply a selected theme to ttk widgets and raw tkinter widgets."""

    def __init__(self, name: str = "Dark Professional") -> None:
        self.name = name if name in THEMES else "Dark Professional"
        self.config = THEMES[self.name]

    def color(self, key: str) -> str:
        return self.config.colors[key]

    def font(self, key: str) -> tuple[Any, ...]:
        return self.config.fonts[key]

    def apply(self, root: tk.Tk, style: ttk.Style) -> None:
        colors, fonts = self.config.colors, self.config.fonts

        root.configure(bg=colors["bg"])
        style.theme_use("clam")

        style.configure(".", font=fonts["default"])
        style.configure("TFrame", background=colors["bg"])
        style.configure("TLabelframe", background=colors["bg"], foreground=colors["text"])
        style.configure("TLabelframe.Label", background=colors["bg"], foreground=colors["text"], font=fonts["heading"])
        style.configure("TLabel", background=colors["bg"], foreground=colors["text"])
        style.configure("TCheckbutton", background=colors["bg"], foreground=colors["text"], focuscolor=colors["bg"])
        style.configure("TButton", background=colors["accent"], foreground=colors["text"], padding=(8, 4))
        style.map("TButton", background=[("active", colors["highlight"]), ("pressed", colors["highlight"])])
        style.configure("TEntry", fieldbackground=colors["panel"], foreground=colors["text"], insertcolor=colors["text"])
        style.configure("TCombobox", fieldbackground=colors["panel"], foreground=colors["text"])
        style.configure("TNotebook", background=colors["bg"])
        style.configure("TNotebook.Tab", background=colors["panel"], foreground=colors["text"], padding=(16, 7))
        style.map("TNotebook.Tab", background=[("selected", colors["highlight"]), ("active", colors["accent"])])


