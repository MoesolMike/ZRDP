class CollapsibleSection(ttk.Frame):
    """A lightweight drop-down section that hides content until expanded."""

    def __init__(self, parent: tk.Widget, title: str, *, open_: bool = False) -> None:
        super().__init__(parent)
        self.title = title
        self.open_var = tk.BooleanVar(value=open_)

        self.toggle = ttk.Checkbutton(
            self,
            command=self._sync,
            style="Toolbutton",
            variable=self.open_var,
        )
        self.toggle.pack(fill=tk.X, anchor=tk.W)

        self.body = ttk.Frame(self, padding=8)
        self._sync()

    def _sync(self) -> None:
        expanded = self.open_var.get()
        self.toggle.configure(text=f"{'▾' if expanded else '▸'} {self.title}")
        if expanded:
            self.body.pack(fill=tk.X, expand=True)
        else:
            self.body.pack_forget()


